# --- FastAPI Application ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Database (Local Docker Postgres or Supabase Session Pooler URI) ---
DATABASE_URL=postgresql+psycopg://legalyst:legalyst@localhost:55432/legalyst

# --- JWT Authentication ---
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- File Storage (Supabase Storage — replaces Azure Blob #32) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=generated-documents

# --- AI Embeddings & Primary LLM (Google AI Studio Free Tier) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=1536
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT_SECONDS=8.0

# --- Optional OpenRouter LLM Switch (set LLM_PROVIDER=openrouter when ready) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
