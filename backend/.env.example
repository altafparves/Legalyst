# --- FastAPI Application ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Database (Local Docker Postgres or Supabase Session Pooler URI) ---
DATABASE_URL=postgresql+psycopg://legalyst:legalyst@localhost:55432/legalyst

# --- JWT Authentication ---
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- File Storage (Supabase Storage — replaces Azure Blob #32) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=generated-documents

# --- AI Embeddings (Google AI Studio — replaces Azure OpenAI Embeddings #10/#34) ---
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=1536

# --- AI LLM Generation & Reranking (Meta Developer Platform API #57) ---
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=minimal
